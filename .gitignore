# Python cache/artifacts
__pycache__/
*.py[cod]
*.pyo

# macOS
.DS_Store

# Local virtual environments
.venv/
venv/

# Sphinx build output
docs/_build/
docs/.doctrees/

# Generated presentation artifacts
presentations/*.pptx
presentations/*.pdf
presentations/*_manifest.json

# Site-specific settings (accounts, local paths); template: configs/site.example.yaml
configs/site.yaml

# VASP files that must not or need not be committed. POTCARs are licensed by VASP.
POTCAR
WAVECAR
WAVEDER
CHGCAR
CHG
LOCPOT
ELFCAR
TMPCAR
PROCAR
DOSCAR
PCDAT
vasprun.xml
vaspout.h5
*.tmp

# Per-invocation batch summaries (the same information lives in each run's manifest)
results/batch_logs/

# Tool caches
.pytest_cache/
.ruff_cache/
*.egg-info/

# Run configs generated by `hsol plan` (reproducible from configs/campaigns/;
# every run directory keeps its own snapshot in inputs/config.yaml)
configs/generated/
docs/_autosummary/
